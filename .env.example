# Firebase — Consola > Configuración del proyecto > Tus apps > SDK setup.
# Es el mismo proyecto que usa la web (bumko-6978f).
# Copia este archivo a .env y completa los valores. .env no se sube al repo.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In. Los IDs salen de la consola de Google Cloud, en
# APIs y servicios > Credenciales, dentro del mismo proyecto de Firebase.
#
# El "Web" es el obligatorio, incluso estando en un teléfono: es el que
# Firebase reconoce como suyo al validar el token que devuelve Google.
# Ya existe — es el que usa la web para su login.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=

# El de iOS solo hace falta para compilar a iPhone.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=

# Android no necesita ninguna variable: alcanza con haber registrado la huella
# SHA-1 de la firma en un cliente OAuth de tipo Android. Sin ese registro el
# selector de cuentas abre y falla con DEVELOPER_ERROR.
