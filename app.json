{
  "expo": {
    "name": "Bumko",
    "slug": "bumkoapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bumko",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.imago.bumko",
      "infoPlist": {
        "NSContactsUsageDescription": "Bumko usa tus contactos solo cuando eliges a quién invitar al equipo. Se guarda el correo del contacto que elijas y nada más."
      }
    },
    "android": {
      "package": "com.imago.bumko",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-contacts",
        {
          "contactsPermission": "Bumko usa tus contactos solo cuando eliges a quién invitar al equipo."
        }
      ]
    ]
  }
}
